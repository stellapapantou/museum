---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@sanity/client';
import '../../styles/episkepsi.css';

const client = createClient({
  projectId: '0r57yr3e',
  dataset: 'production',
  apiVersion: '2026-03-01',
  useCdn: false,
});

const page = await client.fetch(`
  *[_type == "visitPage"][0]{
    title,
    intro,
    kraniaTitle,
    kraniaText,
    bridgesTitle,
    bridgesText,
    valiaKaldaTitle,
    valiaKaldaText,
    activitiesTitle,
    activitiesText,
    seoTitle,
    seoDescription
  }
`);

const title = page?.title || 'Η ΚΡΑΝΙΑ & Η ΠΙΝΔΟΣ';
const intro = page?.intro || '';
const kraniaTitle = page?.kraniaTitle || 'Η ΚΡΑΝΙΑ ΓΡΕΒΕΝΩΝ';
const kraniaText = page?.kraniaText || '';
const bridgesTitle = page?.bridgesTitle || 'Εξερευνήστε τα γεφύρια';
const bridgesText = page?.bridgesText || '';
const valiaKaldaTitle = page?.valiaKaldaTitle || 'Βάλια Κάλντα';
const valiaKaldaText = page?.valiaKaldaText || '';
const activitiesTitle =
  page?.activitiesTitle || 'ΤΙ ΝΑ ΚΑΝΕΤΕ ΣΤΗΝ ΠΕΡΙΟΧΗ';
const activitiesText = page?.activitiesText || '';

const activities = activitiesText
  ? activitiesText
      .split(/\n\s*\n/)
      .map((block) => {
        const lines = block
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean);

        const heading = lines[0] || '';
        const text = lines.slice(1).join(' ');

        return {
          heading: heading.replace(/^\d+\s*—\s*/, ''),
          text,
        };
      })
      .filter((activity) => activity.heading && activity.text)
  : [];

const seoTitle =
  page?.seoTitle ||
  'Η Κρανιά & η Πίνδος | Το Μονοπάτι του Μαλλιού';

const seoDescription =
  page?.seoDescription ||
  'Γνωρίστε την Κρανιά Γρεβενών, τα πέτρινα γεφύρια, τη Βάλια Κάλντα και τη φύση της Πίνδου.';
---

<Layout
  title={seoTitle}
  description={seoDescription}
>
  <main class="page">

    <section class="page-hero">
      <div>
        <p class="eyebrow">Το χωριό μας</p>
        <h1>{title}</h1>
      </div>
    </section>

    <section class="content-section">
      <div class="section-title">
        <h2>{kraniaTitle}</h2>
        <span></span>
      </div>

      <div class="two-column">
        <div>
          <p class="lead">
            {intro}
          </p>
        </div>

        <div>
          {kraniaText
            .split(/\n\s*\n/)
            .filter(Boolean)
            .map((paragraph) => (
              <p>{paragraph}</p>
            ))}
        </div>
      </div>
    </section>

    <section class="content-section things-to-do">

      <div class="section-title">
        <h2>{activitiesTitle}</h2>
        <span></span>
      </div>

      <div class="activities">

        <article>
          <div class="activity-number">01</div>
          <h3>{bridgesTitle}</h3>
          <p>{bridgesText}</p>
        </article>

        <article>
          <div class="activity-number">02</div>
          <h3>{valiaKaldaTitle}</h3>
          <p>{valiaKaldaText}</p>
        </article>

        {activities.slice(2).map((activity, index) => (
          <article>
            <div class="activity-number">
              {String(index + 3).padStart(2, '0')}
            </div>
            <h3>{activity.heading}</h3>
            <p>{activity.text}</p>
          </article>
        ))}

      </div>
    </section>

    <section class="museum-cta">
      <div>
        <p class="eyebrow">Και φυσικά...</p>
        <h2>Ελάτε να γνωρίσετε<br />το Μονοπάτι του Μαλλιού</h2>
      </div>

      <a href="/epikoinonia/" class="button">
        ΚΛΕΙΣΤΕ ΤΗΝ ΕΠΙΣΚΕΨΗ ΣΑΣ →
      </a>
    </section>

  </main>
</Layout>