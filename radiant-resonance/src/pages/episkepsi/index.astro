---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: '0r57yr3e',
  dataset: 'production',
  apiVersion: '2026-03-01',
  useCdn: false,
});

const page = await client.fetch(`
  *[_type == "visitPage"][0]{
    title,
    intro,
    kraniaTitle,
    kraniaText,
    bridgesTitle,
    bridgesText,
    valiaKaldaTitle,
    valiaKaldaText,
    activitiesTitle,
    activitiesText,
    seoTitle,
    seoDescription
  }
`);

const title = page?.title || 'Η ΚΡΑΝΙΑ & Η ΠΙΝΔΟΣ';
const intro = page?.intro || '';
const kraniaTitle = page?.kraniaTitle || 'Η ΚΡΑΝΙΑ ΓΡΕΒΕΝΩΝ';
const kraniaText = page?.kraniaText || '';
const bridgesTitle = page?.bridgesTitle || 'Εξερευνήστε τα γεφύρια';
const bridgesText = page?.bridgesText || '';
const valiaKaldaTitle = page?.valiaKaldaTitle || 'Βάλια Κάλντα';
const valiaKaldaText = page?.valiaKaldaText || '';
const activitiesTitle =
  page?.activitiesTitle || 'ΤΙ ΝΑ ΚΑΝΕΤΕ ΣΤΗΝ ΠΕΡΙΟΧΗ';
const activitiesText = page?.activitiesText || '';

const activities = activitiesText
  ? activitiesText
      .split(/\n\s*\n/)
      .map((block) => {
        const lines = block
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean);

        const heading = lines[0] || '';
        const text = lines.slice(1).join(' ');

        return {
          heading: heading.replace(/^\d+\s*—\s*/, ''),
          text,
        };
      })
      .filter((activity) => activity.heading && activity.text)
  : [];

const seoTitle =
  page?.seoTitle ||
  'Η Κρανιά & η Πίνδος | Το Μονοπάτι του Μαλλιού';

const seoDescription =
  page?.seoDescription ||
  'Γνωρίστε την Κρανιά Γρεβενών, τα πέτρινα γεφύρια, τη Βάλια Κάλντα και τη φύση της Πίνδου.';
---

<Layout
  title={seoTitle}
  description={seoDescription}
>
  <main class="page">

    <section class="page-hero">
      <div>
        <p class="eyebrow">Το χωριό μας</p>
        <h1>{title}</h1>
      </div>
    </section>

    <section class="content-section">
      <div class="section-title">
        <h2>{kraniaTitle}</h2>
        <span></span>
      </div>

      <div class="two-column">
        <div>
          <p class="lead">
            {intro}
          </p>
        </div>

        <div>
          {kraniaText
            .split(/\n\s*\n/)
            .filter(Boolean)
            .map((paragraph) => (
              <p>{paragraph}</p>
            ))}
        </div>
      </div>
    </section>

    <section class="content-section things-to-do">

      <div class="section-title">
        <h2>{activitiesTitle}</h2>
        <span></span>
      </div>

      <div class="activities">

        <article>
          <div class="activity-number">01</div>
          <h3>{bridgesTitle}</h3>
          <p>{bridgesText}</p>
        </article>

        <article>
          <div class="activity-number">02</div>
          <h3>{valiaKaldaTitle}</h3>
          <p>{valiaKaldaText}</p>
        </article>

        {activities.slice(2).map((activity, index) => (
          <article>
            <div class="activity-number">
              {String(index + 3).padStart(2, '0')}
            </div>
            <h3>{activity.heading}</h3>
            <p>{activity.text}</p>
          </article>
        ))}

      </div>
    </section>

    <section class="museum-cta">
      <div>
        <p class="eyebrow">Και φυσικά...</p>
        <h2>Ελάτε να γνωρίσετε<br />το Μονοπάτι του Μαλλιού</h2>
      </div>

      <a href="/epikoinonia/" class="button">
        ΚΛΕΙΣΤΕ ΤΗΝ ΕΠΙΣΚΕΨΗ ΣΑΣ →
      </a>
    </section>

  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #f5f1ea;
    color: #37332e;
  }

  .page {
    min-height: 100vh;
  }

  .page-hero {
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    padding: 70px 6%;
    color: white;
    background:
      linear-gradient(
        rgba(0, 0, 0, .45),
        rgba(0, 0, 0, .55)
      ),
      url('/images/location.jpg') center / cover;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(55px, 8vw, 105px);
    line-height: .9;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .content-section {
    padding: 90px 6%;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 55px;
  }

  .section-title h2 {
    margin: 0;
    font-size: 21px;
    font-weight: 400;
    white-space: nowrap;
  }

  .section-title span {
    width: 100%;
    height: 1px;
    background: #c6bdb2;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8%;
    max-width: 1100px;
  }

  .two-column p {
    font-family: Arial, sans-serif;
    font-size: 15px;
    line-height: 1.8;
  }

  .two-column .lead {
    margin: 0;
    font-family: Georgia, serif;
    font-size: 29px;
    line-height: 1.35;
  }

  .things-to-do {
    padding-top: 20px;
  }

  .activities {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 55px 8%;
  }

  .activities article {
    border-top: 1px solid #bdb3a8;
    padding-top: 20px;
  }

  .activity-number {
    font-family: Arial, sans-serif;
    font-size: 12px;
  }

  .activities h3 {
    margin: 45px 0 12px;
    font-size: 28px;
    font-weight: 400;
  }

  .activities p {
    max-width: 500px;
    margin: 0;
    font-family: Arial, sans-serif;
    font-size: 14px;
    line-height: 1.7;
  }

  .museum-cta {
    margin: 0 4% 60px;
    padding: 55px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    background: #747653;
    color: white;
    border-radius: 6px;
  }

  .museum-cta h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 55px);
    line-height: 1;
    font-weight: 400;
  }

  .button {
    display: inline-flex;
    padding: 17px 22px;
    background: white;
    color: #37332e;
    border-radius: 4px;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .page-hero {
      min-height: 450px;
      padding: 45px 5%;
    }

    .content-section {
      padding: 65px 5%;
    }

    .two-column,
    .activities {
      grid-template-columns: 1fr;
    }

    .two-column {
      gap: 25px;
    }

    .activities {
      gap: 40px;
    }

    .museum-cta {
      margin: 0 5% 40px;
      padding: 35px 25px;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
