---
import Layout from "../../layouts/Layout.astro";
import { createClient } from "@sanity/client";

const client = createClient({
  projectId: "0r57yr3e",
  dataset: "production",
  apiVersion: "2026-03-01",
  useCdn: false,
});

const page = await client.fetch(`
  *[_type == "contactPage"][0]{
    title,
    intro,
    address,
    phone,
    hours,
    mapUrl,
    mapLatitude,
    mapLongitude,
    seoTitle,
    seoDescription
  }
`);

const title = page?.title || "ΕΠΙΣΚΕΦΘΕΙΤΕ ΜΑΣ";

const intro = page?.intro || `Θα χαρούμε να
σας υποδεχτούμε.`;

const address = page?.address || "Κρανιά Γρεβενών";

const phone = page?.phone || "697 681 3887";

const hours = page?.hours || `Καθημερινά
Κατόπιν τηλεφωνικής συνεννόησης`;

const googleMapsUrl =
  page?.mapUrl ||
  "https://www.google.com/maps/place/%CE%A4%CE%9F+%CE%9C%CE%9F%CE%9D%CE%9F%CE%A0%CE%91%CE%A4%CE%99+%CE%A4%CE%9F%CE%A5+%CE%9C%CE%91%CE%9B%CE%9B%CE%99%CE%9F%CE%A5/@39.8964963,21.2783524,690m";

const latitude = page?.mapLatitude || 39.8964963;

const longitude = page?.mapLongitude || 21.2783524;

const mapEmbedUrl =
  `https://www.google.com/maps?q=${latitude},${longitude}&z=17&output=embed`;

const seoTitle =
  page?.seoTitle ||
  "Επικοινωνία | Το Μονοπάτι του Μαλλιού";

const seoDescription =
  page?.seoDescription ||
  "Επικοινωνήστε με το Μονοπάτι του Μαλλιού στην Κρανιά Γρεβενών και κλείστε την επίσκεψή σας στο μουσείο.";

const hoursLines = hours
  .split("\n")
  .map((line) => line.trim())
  .filter(Boolean);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  transparentHeader={true}
>
  <main class="page">

    <section class="page-hero">
      <div>
        <p class="eyebrow">Επικοινωνία</p>
        <h1>{title}</h1>
      </div>
    </section>

    <section class="contact-section">

      <div class="contact-intro">
        <p class="eyebrow">Το Μονοπάτι του Μαλλιού</p>
        <h2>
          {intro.split("\n").map((line, index) => (
            <>
              {line}
              {index < intro.split("\n").length - 1 && <br />}
            </>
          ))}
        </h2>
      </div>

      <div class="contact-grid">

        <div class="contact-details">

          <div class="detail">
            <span class="label">ΔΙΕΥΘΥΝΣΗ</span>

            <p>{address}</p>

            <a
              href={googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="map-link"
            >
              ΔΕΙΤΕ ΤΟΝ ΧΑΡΤΗ →
            </a>
          </div>

          <div class="detail">
            <span class="label">ΤΗΛΕΦΩΝΟ</span>

            <p>
              <a href={`tel:${phone.replace(/\D/g, "")}`}>
                {phone}
              </a>
            </p>
          </div>

          <div class="detail">
            <span class="label">ΩΡΕΣ ΕΠΙΚΟΙΝΩΝΙΑΣ</span>

            <p>
              {hoursLines.map((line, index) => (
                <>
                  {line}
                  {index < hoursLines.length - 1 && <br />}
                </>
              ))}
            </p>

            <small>
              Οι επισκέψεις στο μουσείο γίνονται
              κατόπιν τηλεφωνικής συνεννόησης.
            </small>
          </div>

        </div>

        <div class="map-container">
          <iframe
            src={mapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Το Μονοπάτι του Μαλλιού - Κρανιά Γρεβενών"
          ></iframe>
        </div>

      </div>

    </section>

  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #f5f1ea;
    color: #37332e;
  }

  .page {
    min-height: 100vh;
  }

  .page-hero {
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    padding: 70px 6%;
    color: white;
    background:
      linear-gradient(
        rgba(0, 0, 0, .42),
        rgba(0, 0, .58)
      ),
      url('/images/door.jpg') center / cover;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(55px, 8vw, 105px);
    line-height: .9;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .contact-section {
    padding: 90px 6%;
  }

  .contact-intro {
    margin-bottom: 75px;
  }

  .contact-intro h2 {
    margin: 0;
    font-size: clamp(40px, 5vw, 70px);
    line-height: .98;
    font-weight: 400;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 7%;
    max-width: 1300px;
  }

  .detail {
    border-top: 1px solid #bdb3a8;
    padding: 25px 0 35px;
  }

  .label {
    font-family: Arial, sans-serif;
    font-size: 11px;
    letter-spacing: .12em;
  }

  .detail p {
    margin: 18px 0 10px;
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }

  .detail p a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .map-link {
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
  }

  .detail small {
    display: block;
    max-width: 350px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.6;
    color: #756d64;
  }

  .map-container {
    min-height: 500px;
    background: #ddd5cb;
  }

  .map-container iframe {
    width: 100%;
    height: 100%;
    min-height: 500px;
    border: 0;
    display: block;
  }

  @media (max-width: 800px) {
    .page-hero {
      min-height: 420px;
      padding: 50px 5%;
    }

    .contact-section {
      padding: 65px 5%;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .map-container,
    .map-container iframe {
      min-height: 400px;
    }
  }
</style>
