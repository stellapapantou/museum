---
interface Props {
  copyright?: string;
  instagramUrl?: string;
}

const {
  copyright = "© 2024 Το Μονοπάτι του Μαλλιού – Θεματικό Μουσείο Κρανιάς Γρεβενών",
  instagramUrl,
} = Astro.props;
---

<footer class="site-footer" id="contact">
  <div class="site-footer__inner">

    <p class="site-footer__copyright">
      {copyright}
    </p>

    {instagramUrl && (
      <a
        href={instagramUrl}
        class="site-footer__instagram"
        aria-label="Instagram"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
    )}

  </div>
</footer>